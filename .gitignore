# ignore configurations files other than the template(config.yaml)
/resources/*
!/resources/control-scripts
!/resources/sample*.yaml
/scripts/push_bin.sh
binaries/*
builds/*
.vscode/*
!.vscode/settings.json

# web-console build artifacts (also listed in web-console/.gitignore)
/web-console/node_modules
/web-console/build
/web-console/coverage
/web-console/.yarn
/web-console/.cache_*
/web-console/.env
/web-console/tx
/pkg/http_router/web-console/assets/web_console.zip
